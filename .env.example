APP_HOST=0.0.0.0
APP_PORT=8080
APP_NAME=pos-backend
# APP_ENV gates production-safety checks. Default "development" keeps local dev
# working with the placeholder secret below. When APP_ENV is "staging" or
# "production", the server REFUSES to start unless APP_TOKEN_KEY is changed from
# the default — generate one with: openssl rand -hex 32
APP_ENV=development
APP_TOKEN_KEY=change-this-secret
APP_CORS_ALLOW_ORIGINS=http://localhost:3000
APP_AUTO_MIGRATE=true
APP_MIGRATIONS_DIR=init-db
APP_UPLOAD_DIR=storage

POSTGRES_HOST=127.0.0.1
POSTGRES_DB=pos_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_NAME=pos-assets
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BROWSER_REDIRECT_URL=
MINIO_SERVER_URL=

# ── MinIO storage ─────────────────────────────────────────────
# MINIO_ENDPOINT / MINIO_USE_SSL = how the BACKEND connects to MinIO internally.
#   Keep 127.0.0.1:9000 + false — the SDK talks to localhost inside the server.
# MINIO_PUBLIC_URL = the base URL handed to BROWSERS for uploaded assets
#   (product images, payment proofs, PDFs). In production this MUST be the public
#   HTTPS tunnel host (e.g. https://media.<your-zone>) — NOT 127.0.0.1, which the
#   client's browser cannot reach. No bucket suffix, no trailing slash.
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://127.0.0.1:9000


PDF_TTF_PATH="/System/Library/Fonts/Supplemental/ArialUnicode.ttf"

CHROME_PATH=/usr/bin/chromium
