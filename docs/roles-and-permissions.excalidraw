    { "type": "text", "id": "title", "x": 50, "y": 20, "text": "POS สิทธิ์ตามบทบาท (Role-Based Access Flow)", "fontSize": 28, "fontFamily": 1, "strokeColor": "#1e1e1e", "originalText": "POS สิทธิ์ตามบทบาท (Role-Based Access Flow)", "autoResize": true },

    { "type": "rectangle", "id": "r_login", "x": 600, "y": 80, "width": 240, "height": 60, "roundness": { "type": 3 }, "backgroundColor": "#a5d8ff", "fillStyle": "solid", "boundElements": [{ "id": "t_login", "type": "text" }] },
    { "type": "text", "id": "t_login", "x": 605, "y": 95, "width": 230, "height": 30, "text": "เข้าสู่ระบบ (Login)\nJWT มี role claim", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_login", "originalText": "เข้าสู่ระบบ (Login)\nJWT มี role claim", "autoResize": true },

    { "type": "arrow", "id": "a_login", "x": 720, "y": 140, "width": 0, "height": 60, "points": [[0,0],[0,60]], "endArrowhead": "arrow", "startBinding": { "elementId": "r_login", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "d_role", "fixedPoint": [0.5, 0] } },

    { "type": "diamond", "id": "d_role", "x": 600, "y": 200, "width": 240, "height": 130, "backgroundColor": "#fff3bf", "fillStyle": "solid", "boundElements": [{ "id": "t_role", "type": "text" }] },
    { "type": "text", "id": "t_role", "x": 605, "y": 245, "width": 230, "height": 40, "text": "Role?", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "d_role", "originalText": "Role?", "autoResize": true },

    { "type": "arrow", "id": "a_owner", "x": 720, "y": 330, "width": 0, "height": 0, "points": [[0,0],[-420,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "d_role", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_owner", "fixedPoint": [0.5, 0] } },
    { "type": "arrow", "id": "a_manager", "x": 720, "y": 330, "width": 0, "height": 0, "points": [[0,0],[0,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "d_role", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_manager", "fixedPoint": [0.5, 0] } },
    { "type": "arrow", "id": "a_cashier", "x": 720, "y": 330, "width": 0, "height": 0, "points": [[0,0],[420,70]], "endArrowhead": "arrow", "startBinding": { "elementId": "d_role", "fixedPoint": [0.5, 1] }, "endBinding": { "elementId": "r_cashier", "fixedPoint": [0.5, 0] } },

    { "type": "rectangle", "id": "r_owner", "x": 150, "y": 400, "width": 300, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#d0bfff", "fillStyle": "solid", "boundElements": [{ "id": "t_owner", "type": "text" }] },
    { "type": "text", "id": "t_owner", "x": 155, "y": 420, "width": 290, "height": 30, "text": "เจาของ (Owner)", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_owner", "originalText": "เจาของ (Owner)", "autoResize": true },

    { "type": "rectangle", "id": "r_manager", "x": 570, "y": 400, "width": 300, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#b2f2bb", "fillStyle": "solid", "boundElements": [{ "id": "t_manager", "type": "text" }] },
    { "type": "text", "id": "t_manager", "x": 575, "y": 420, "width": 290, "height": 30, "text": "ผูจัดการ (Manager)", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_manager", "originalText": "ผูจัดการ (Manager)", "autoResize": true },

    { "type": "rectangle", "id": "r_cashier", "x": 990, "y": 400, "width": 300, "height": 70, "roundness": { "type": 3 }, "backgroundColor": "#ffd8a8", "fillStyle": "solid", "boundElements": [{ "id": "t_cashier", "type": "text" }] },
    { "type": "text", "id": "t_cashier", "x": 995, "y": 420, "width": 290, "height": 30, "text": "แคชเชียร (Cashier)", "fontSize": 20, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "center", "verticalAlign": "middle", "containerId": "r_cashier", "originalText": "แคชเชียร (Cashier)", "autoResize": true },

    { "type": "rectangle", "id": "r_owner_menu", "x": 150, "y": 510, "width": 300, "height": 270, "roundness": { "type": 3 }, "backgroundColor": "#e5dbff", "fillStyle": "solid", "boundElements": [{ "id": "t_owner_menu", "type": "text" }] },
    { "type": "text", "id": "t_owner_menu", "x": 155, "y": 520, "width": 290, "height": 250, "text": "เห็นทุกเมนู:\n- POS / ขาย\n- สินคา (เพิ่ม/แก/ลบ)\n- ลูกคา (เพิ่ม/แก)\n- ใบแจงหนี้ / รับชำระ\n- รายงาน / ยอดขาย\n- พนักงาน / ผูใช\n- โปรไฟลราน / แพ็กเกจ\n- ตั้งคา / Log", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "top", "containerId": "r_owner_menu", "originalText": "เห็นทุกเมนู:\n- POS / ขาย\n- สินคา (เพิ่ม/แก/ลบ)\n- ลูกคา (เพิ่ม/แก)\n- ใบแจงหนี้ / รับชำระ\n- รายงาน / ยอดขาย\n- พนักงาน / ผูใช\n- โปรไฟลราน / แพ็กเกจ\n- ตั้งคา / Log", "autoResize": true },

    { "type": "rectangle", "id": "r_manager_menu", "x": 570, "y": 510, "width": 300, "height": 250, "roundness": { "type": 3 }, "backgroundColor": "#d3f9d8", "fillStyle": "solid", "boundElements": [{ "id": "t_manager_menu", "type": "text" }] },
    { "type": "text", "id": "t_manager_menu", "x": 575, "y": 520, "width": 290, "height": 230, "text": "เห็น:\n- POS / ขาย\n- สินคา (เพิ่ม/แก)\n- ลูกคา (เพิ่ม/แก)\n- ใบแจงหนี้ / รับชำระ\n- รายงาน / ยอดขาย\n- ตั้งคาราน / Log\n\nX ไมเห็น:\n- พนักงาน / ผูใช\n- โปรไฟลราน\n- แพ็กเกจ / Subscription", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "top", "containerId": "r_manager_menu", "originalText": "เห็น:\n- POS / ขาย\n- สินคา (เพิ่ม/แก)\n- ลูกคา (เพิ่ม/แก)\n- ใบแจงหนี้ / รับชำระ\n- รายงาน / ยอดขาย\n- ตั้งคาราน / Log\n\nX ไมเห็น:\n- พนักงาน / ผูใช\n- โปรไฟลราน\n- แพ็กเกจ / Subscription", "autoResize": true },

    { "type": "rectangle", "id": "r_cashier_menu", "x": 990, "y": 510, "width": 300, "height": 250, "roundness": { "type": 3 }, "backgroundColor": "#ffec99", "fillStyle": "solid", "boundElements": [{ "id": "t_cashier_menu", "type": "text" }] },
    { "type": "text", "id": "t_cashier_menu", "x": 995, "y": 520, "width": 290, "height": 230, "text": "เห็น:\n- POS ขายหนาราน\n- คนหาลูกคา\n- ประวัติการขายตัวเอง\n\nX ไมเห็น:\n- แกไขสินคา/ราคา\n- ลูกคา (เพิ่ม/แก)\n- ใบแจงหนี้\n- รายงาน / ยอดขาย\n- ตั้งคา / พนักงาน\n- แพ็กเกจ", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "top", "containerId": "r_cashier_menu", "originalText": "เห็น:\n- POS ขายหนาราน\n- คนหาลูกคา\n- ประวัติการขายตัวเอง\n\nX ไมเห็น:\n- แกไขสินคา/ราคา\n- ลูกคา (เพิ่ม/แก)\n- ใบแจงหนี้\n- รายงาน / ยอดขาย\n- ตั้งคา / พนักงาน\n- แพ็กเกจ", "autoResize": true },

    { "type": "rectangle", "id": "r_rules", "x": 150, "y": 820, "width": 1140, "height": 150, "roundness": { "type": 3 }, "backgroundColor": "#c3fae8", "fillStyle": "solid", "boundElements": [{ "id": "t_rules", "type": "text" }] },
    { "type": "text", "id": "t_rules", "x": 165, "y": 835, "width": 1110, "height": 120, "text": "กฎพิเศษ (ตอง enforce ที่ backend ดวย):\n1. สรางพนักงาน / กำหนด role -> Owner เทานั้น\n2. Void / Refund / ลบสินคา -> Manager ขึ้นไป\n3. สวนลดเกินเกณฑ / ปดกะ -> Manager อนุมัติ\n4. Menu ซอนคือ UX อยางเดียว — API ตองเชค role ทุก endpoint (JWT middleware)", "fontSize": 16, "fontFamily": 1, "strokeColor": "#1e1e1e", "textAlign": "left", "verticalAlign": "top", "containerId": "r_rules", "originalText": "กฎพิเศษ (ตอง enforce ที่ backend ดวย):\n1. สรางพนักงาน / กำหนด role -> Owner เทานั้น\n2. Void / Refund / ลบสินคา -> Manager ขึ้นไป\n3. สวนลดเกินเกณฑ / ปดกะ -> Manager อนุมัติ\n4. Menu ซอนคือ UX อยางเดียว — API ตองเชค role ทุก endpoint (JWT middleware)", "autoResize": true }
  ],
